# Supabase 프로젝트 연결 설정 (필수)
# Supabase Dashboard > Project Settings > API 에서 확인 후 .env.local 에 입력하세요.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# OpenAI Vision OCR 설정 (선택)
# 미설정 시 /api/parse-items 가 데모 거래명세서 샘플 파싱 결과를 반환하는 Mock 모드로 동작합니다.
OPENAI_API_KEY=
